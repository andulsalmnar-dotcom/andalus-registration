rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function myEmail() { return request.auth.token.email.lower(); }
    function roles() { return get(/databases/$(database)/documents/config/roles).data; }
    function isEditor() { return request.auth != null && myEmail() in roles().get('editors', []); }
    function isViewer() { return request.auth != null && (isEditor() || myEmail() in roles().get('viewers', [])); }

    match /{document=**} {
      allow read: if isViewer();
      allow write: if isEditor();
    }
  }
}
